{
  "name": "sirivatana-intranet",
  "version": "1.0.0",
  "description": "Sirivatana Intranet: public site + CMS (news / content) with user management and audit log",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/run-sql.js database/schema.sql database/seed.sql && node scripts/seed-users.js",
    "db:seed-users": "node scripts/seed-users.js",
    "db:reset": "node scripts/reset-db.js && npm run db:init",
    "create-admin": "node scripts/create-admin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.6",
    "multer": "^2.4.0",
    "sanitize-html": "^2.18.1"
  }
}
