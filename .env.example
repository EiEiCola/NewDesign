# Copy this file to .env and fill in the values

PORT=3000
NODE_ENV=development

# Microsoft SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SirivatanaIntranet
DB_USER=sa
DB_PASSWORD=change_me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_HOURS=8

# Upload limit per file (MB)
UPLOAD_MAX_MB=20

# Default accounts created by npm run db:init / npm run db:seed-users
# Use these for development only; change the passwords on a real server.
# Leave a *_USERNAME empty to skip that account. *_ROLE overrides the role (admin | editor | user).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_admin
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=change_me_user
