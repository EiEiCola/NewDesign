# Copy this file to .env and fill in the values

PORT=3000
NODE_ENV=development

# Microsoft SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SirivatanaIntranet
DB_USER=sa
DB_PASSWORD=change_me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_HOURS=8

# Upload limit per file (MB)
UPLOAD_MAX_MB=20
